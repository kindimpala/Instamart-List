# --- Agent (server-side only; never exposed to the browser) ---
# Leave empty to use the built-in rules agent (offline demo, no LLM).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Swiggy Instamart MCP ---
# stub | staging | production
SWIGGY_MODE=stub
# Must exactly match a redirect URI allowlisted by Swiggy (exact match, no wildcards).
SWIGGY_REDIRECT_URI=http://localhost:3000/auth/callback

# --- Sessions ---
# 32+ random characters. Required outside stub mode. Generate: openssl rand -base64 48
SESSION_SECRET=

# --- Optional ---
# Stub scenario flags: oos,price,surge,eta,noeta (or "demo" = oos,price,surge)
STUB_FLAGS=
# Override the OAuth authorization server (default https://mcp.swiggy.com)
# SWIGGY_AUTH_BASE=https://mcp.swiggy.com
# Pre-registered client ID (skips dynamic client registration)
# SWIGGY_CLIENT_ID=
# Delivery coordinates for track_order (get_addresses does not return lat/lng)
# SWIGGY_TRACK_LAT=
# SWIGGY_TRACK_LNG=
# file (default locally) | blobs (default on Netlify)
# STORAGE=file
